{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": "src",
    "paths": {
      "src/*": ["./*"],
      "assets/*": ["./assets/*"],
      "components/*": ["./components/*"],
      "contexts/*": ["./contexts/*"],
      "hooks/*": ["./hooks/*"],
      "integrations/*": ["./integrations/*"],
      "lib/*": ["./lib/*"],
      "pages/*": ["./pages/*"],
      "types/*": ["./types/*"],
      "utils/*": ["./utils/*"],
      "constants/*": ["./constants/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
