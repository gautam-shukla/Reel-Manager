{
  "name": "reel-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "extension"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,cyan.bold\" \"npm run dev --workspace=@reel-manager/backend\" \"npm run dev --workspace=@reel-manager/frontend\"",
    "dev:frontend": "npm run dev --workspace=@reel-manager/frontend",
    "dev:backend": "npm run dev --workspace=@reel-manager/backend",
    "dev:extension": "npm run dev --workspace=@reel-manager/extension",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=@reel-manager/frontend",
    "build:backend": "npm run build --workspace=@reel-manager/backend",
    "build:extension": "npm run build --workspace=@reel-manager/extension",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
